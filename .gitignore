# Large SDK installer archives (zip/tar, tens of GB) — not meant for git
*.zip
*.tar
*.tar.gz

# mythic_sdk/: the vendor SDK drop, one subdirectory per SDK version
# (mythic_sdk/v26.05.0/, mythic_sdk/v26.05.2/, ...). Each holds installer
# payloads, extracted sources, vendor docs, and launch scripts. The whole
# subtree is NOT tracked in git — SDK versions are fetched from S3
# (s3://mythic-sdk/<version>/) on demand and unpacked here locally.
mythic_sdk/

# output/: generated artifacts (videos, etc.) — reproducible, not meant for git
output/

# OS/editor cruft
.DS_Store
__pycache__/
*.pyc
