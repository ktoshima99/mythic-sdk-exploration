# helper macro to format outputs
macro(format_output _var)
  # if output is empty, write <empty> string into output variable
  if("${${_var}}" STREQUAL "")
    set(${_var} <empty>)
  else() # output not empty
    # if output not begins with a new line, add a new line at the beginning
    if(NOT ${_var} MATCHES "^\n")
      set(${_var} "\n${${_var}}")
    endif()
    # if output not ends with a new line, add a new line at the end
    if(NOT ${_var} MATCHES "\n$")
      set(${_var} "${${_var}}\n")
    endif()
  endif()
endmacro(format_output)

message(STATUS "=============================================================================")
message(STATUS "CTEST_FULL_OUTPUT (avoid ctest truncation of output)")
message(STATUS "")

# commands to execute
set(PRE_BUILD_TARGET_COMMANDS @VID_TEST_PRE_BUILD_TARGET@)
set(BUILD_TARGET @VID_TEST_BUILD_TARGET@)
set(POST_BUILD_TARGET_COMMANDS @VID_TEST_POST_BUILD_TARGET@)
set(PRE_RUN_TARGET_COMMANDS @VID_TEST_PRE_RUN_TARGET@)
set(RUN_TARGET @VID_TEST_RUN_TARGET@)
set(POST_RUN_TARGET_COMMANDS @VID_TEST_POST_RUN_TARGET@)
set(TEST_COMMANDS @VID_TEST_TEST@)


if(PRE_BUILD_TARGET_COMMANDS)
  # execute command in build target working directory
  execute_process(COMMAND bash -c "@VID_TEST_PRE_BUILD_TARGET_COMMANDS@"
    WORKING_DIRECTORY @VID_TEST_BUILD_TARGET_WORKING_DIR@
    RESULT_VARIABLE pre_build_target_commands_result
    OUTPUT_VARIABLE pre_build_target_commands_output
    ERROR_VARIABLE pre_build_target_commands_error)

  format_output(pre_build_target_commands_output)
  format_output(pre_build_target_commands_error)

  # check return code of command
  if(pre_build_target_commands_result)
    message(FATAL_ERROR "PRE_BUILD_TARGET_COMMANDS execution returned with code ${pre_build_target_commands_result} output=${pre_build_target_commands_output} error=${pre_build_target_commands_error}")
  else()
    message(STATUS "PRE_BUILD_TARGET_COMMANDS output=${pre_build_target_commands_output}")
  endif()
endif()

